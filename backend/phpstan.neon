includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app
        - database/factories
        - database/seeders
        - tests/Fixtures
    ignoreErrors:
        # Traits de teste (CenarioDeNota, AssinaNfeDeTeste) são usadas só por testes, que não estão em `paths`.
        -
            identifier: trait.unused
            path: tests/Fixtures/*
