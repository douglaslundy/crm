# Modelo do deploy/.env (o .env real NÃO vai para o git). O deploy.sh gera o .env na primeira vez.
# Troque HOST pelo IP ou domínio de onde o sistema será acessado.
HOST=192.168.0.233
WEB_PORT=3200
API_PORT=8200

# --- Banco ---
DB_DATABASE=plataforma
DB_USERNAME=plataforma
DB_PASSWORD=trocar

# --- Frontend (assado no build) ---
NEXT_PUBLIC_API_URL=http://192.168.0.233:8200

# --- Laravel ---
APP_NAME="Plataforma Fiscal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.0.233:8200
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432

# Front (3200) e API (8200) no mesmo host: cookie host-only vale para as duas portas.
FRONTEND_URL=http://192.168.0.233:3200
SANCTUM_STATEFUL_DOMAINS=192.168.0.233:3200
SESSION_DRIVER=database
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
BRASILAPI_URL=https://brasilapi.com.br

# Imagem serversideup: não rodar migrations sozinha (o deploy.sh roda explicitamente).
AUTORUN_ENABLED=false
PHP_OPCACHE_ENABLE=1
SSL_MODE=off
