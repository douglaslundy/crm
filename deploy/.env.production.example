# Modelo do deploy/.env de PRODUÇÃO (o .env real NÃO vai para o git). Copie para deploy/.env, preencha e siga
# docs/go-live/checklist-producao.md. Crie dois registros DNS (app e api) apontando para a VPS.
APP_DOMAIN=app.exemplo.com.br
API_DOMAIN=api.exemplo.com.br

# --- Banco ---
DB_DATABASE=plataforma
DB_USERNAME=plataforma
DB_PASSWORD=trocar

# --- Frontend (assado no build) ---
NEXT_PUBLIC_API_URL=https://api.exemplo.com.br

# --- Laravel ---
APP_NAME="Plataforma Fiscal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.exemplo.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432

# Front e API em subdomínios do mesmo domínio: cookie no domínio pai, só por HTTPS.
FRONTEND_URL=https://app.exemplo.com.br
SANCTUM_STATEFUL_DOMAINS=app.exemplo.com.br
SESSION_DRIVER=database
SESSION_DOMAIN=.exemplo.com.br
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# O Caddy é o único que fala com a API (as portas do app e do web não são publicadas no host).
TRUSTED_PROXIES=*

QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=log
BRASILAPI_URL=https://brasilapi.com.br

# Bundle de CAs (.pem) usado na verificação TLS da SEFAZ e da ADN (cadeia ICP-Brasil). Vazio = bundle do sistema.
FISCAL_CA_BUNDLE=

# Imagem serversideup: não rodar migrations sozinha (o runbook roda explicitamente).
AUTORUN_ENABLED=false
PHP_OPCACHE_ENABLE=1
SSL_MODE=off

# Produção: sem dependências de desenvolvimento e sem seeder de demonstração.
INSTALL_DEV=0
