# Frontend Next.js. NEXT_PUBLIC_API_URL é "assado" no build: mudou a URL da API, rebuilda.
FROM node:24-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# o prebuild copia o contrato OpenAPI de ../docs/api para public/
COPY docs/api/openapi.yaml /docs/api/openapi.yaml
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm run build

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build /app ./
USER node
EXPOSE 3000
CMD ["npm", "run", "start"]
